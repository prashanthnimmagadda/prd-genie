{
  "name": "prd-genie",
  "version": "0.1.0-rc.3",
  "private": true,
  "description": "A local-first, bring-your-own-key workbench for drafting and reviewing product requirements.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "fast-json-stringify": {
      "fast-uri": "4.1.3"
    },
    "fast-uri": "3.1.6",
    "hono": "4.13.5",
    "js-yaml": "4.3.1",
    "postcss": {
      "nanoid": "3.3.18"
    },
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build && node scripts/sanitize-build.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "node scripts/record-test-coverage.mjs",
    "test:e2e": "playwright test",
    "test:e2e:record": "node scripts/record-browser-e2e.mjs",
    "audit:record": "node scripts/record-dependency-audit.mjs",
    "gate:node": "node scripts/record-node-gate.mjs",
    "accessibility:record": "node scripts/record-accessibility-review.mjs",
    "production:record-smoke": "node scripts/record-production-smoke.mjs",
    "content:check": "node scripts/check-content.mjs",
    "licenses": "node scripts/license-report.mjs",
    "sbom": "node scripts/sbom.mjs",
    "provenance": "node scripts/provenance.mjs",
    "release:verify-approval": "node scripts/verify-promotion-approval.mjs",
    "container:record-smoke": "node scripts/record-container-smoke.mjs",
    "eval:model:setup": "node scripts/setup-eval-model.mjs",
    "eval:model:setup-review": "ollama create prd-genie-qwen3.5-9b-review:latest -f evaluations/ollama-qwen35-review.Modelfile",
    "eval:model": "tsx scripts/evaluate-prd.ts",
    "ci:offline": "node scripts/offline-ci.mjs",
    "ci:offline:quick": "node scripts/offline-ci.mjs --quick",
    "check": "npm run content:check && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.103",
    "@ai-sdk/google": "3.0.101",
    "@ai-sdk/openai": "3.0.88",
    "@ai-sdk/openai-compatible": "2.0.62",
    "@ai-sdk/react": "3.0.238",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@fontsource/source-code-pro": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@huggingface/transformers": "4.2.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tiptap/core": "3.29.1",
    "@tiptap/extension-placeholder": "3.29.1",
    "@tiptap/markdown": "3.29.1",
    "@tiptap/react": "3.29.1",
    "@tiptap/starter-kit": "3.29.1",
    "ai": "6.0.236",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "docx": "9.7.1",
    "drizzle-orm": "0.45.2",
    "env-paths": "4.0.0",
    "fastify": "5.12.1",
    "file-type": "22.0.1",
    "ipaddr.js": "2.4.0",
    "jszip": "3.10.1",
    "lucide-react": "1.27.0",
    "mammoth": "1.12.0",
    "nanoid": "6.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sqlite-vec": "0.1.9",
    "streamdown": "2.6.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "undici": "8.9.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
